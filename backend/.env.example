# Required for the backend and authenticated routes
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# OTP codes are HMAC-hashed with this secret (falls back to JWT_SECRET)
OTP_SECRET=replace-with-a-different-long-random-secret

# Resend email delivery; EMAIL_FROM must be a sender verified with Resend
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Just Do It <no-reply@example.com>

# Optional Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

APP_TIME_ZONE=Asia/Kolkata
PORT=4000
